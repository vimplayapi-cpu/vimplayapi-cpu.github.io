# ---------------------------------------------------------------------------
# Live Miracle — environment configuration
#
# Copy to .env.local for development, or set these in your host's environment
# for production. Never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION.
# Secret used to derive IP hashes, analytics visitor digests and CSRF tokens.
# Must be at least 32 characters. The app refuses to start in production
# without it rather than falling back to a guessable default.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LM_APP_SECRET=

# Absolute public URL, used for canonical tags, the sitemap and OG metadata.
LM_SITE_URL=https://example.com

# Number of trusted reverse proxies in front of the app. Leave at 0 unless you
# terminate TLS behind a proxy you control — it decides how far into
# X-Forwarded-For the real client IP is read, and a wrong value lets a client
# spoof its address to evade rate limits.
LM_TRUSTED_PROXIES=0

# Where the SQLite database is written. Defaults to ./data
# LM_DATA_DIR=/var/lib/live-miracle

# ---------------------------------------------------------------------------
# Initial administrator (read by `npm run db:seed`, first run only)
# ---------------------------------------------------------------------------
# If LM_ADMIN_PASSWORD is omitted, a strong password is generated and printed
# once, and must be changed at first sign-in.
LM_ADMIN_EMAIL=miracle@gmail.com
# LM_ADMIN_PASSWORD=
