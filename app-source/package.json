{
  "name": "live-miracle",
  "version": "1.0.0",
  "private": true,
  "description": "Live Miracle — premium live broadcast studio & production infrastructure company website",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/live-miracle.db* && npm run db:migrate && npm run db:seed",
    "smoke": "tsx scripts/smoke.ts",
    "prebuild": "tsx scripts/build-media.ts && tsx scripts/build-brand.ts",
    "build:media": "tsx scripts/build-media.ts",
    "build:brand": "tsx scripts/build-brand.ts",
    "build:static": "tsx scripts/build-media.ts && tsx scripts/build-brand.ts && tsx scripts/build-static.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
